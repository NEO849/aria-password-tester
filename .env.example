# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Nur für docker-compose.yml: an welche Adresse/welchen Port der Container
# nach außen gebunden wird. Default = nur vom Server selbst erreichbar.
# Für Tailscale-Zugriff von anderen eigenen Geräten: BIND_ADDR auf die
# Tailscale-IP dieses Servers setzen (siehe `tailscale ip -4`).
BIND_ADDR=127.0.0.1
HOST_PORT=8000

# Rate-Limiting (pro IP)
RATE_LIMIT=30/minute

# HIBP-Abfrage aktivieren (true/false)
ENABLE_HIBP=true

# CORS: erlaubte Origins (kommagetrennt). Für rein lokalen Gebrauch reicht der
# eigene Origin. "*" nur setzen, wenn die API von einer anderen Domain aus
# per Browser aufgerufen werden soll.
CORS_ORIGINS=http://localhost:8000
