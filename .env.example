# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Rate-Limiting (pro IP)
RATE_LIMIT=30/minute

# HIBP-Abfrage aktivieren (true/false)
ENABLE_HIBP=true

# CORS: erlaubte Origins (kommagetrennt). Für rein lokalen Gebrauch reicht der
# eigene Origin. "*" nur setzen, wenn die API von einer anderen Domain aus
# per Browser aufgerufen werden soll.
CORS_ORIGINS=http://localhost:8000
